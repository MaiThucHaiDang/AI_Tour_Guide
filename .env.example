# ─── Environment ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── API Keys ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_tour_guide

# ─── LLM Configuration ──────────────────────────────────────────────────────
LLM_PROVIDER_ORDER=gemini,groq
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-flash-latest
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3 
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=180
VISION_CONFIDENCE_THRESHOLD=0.6

# ─── Request Limits / Cost Guard ────────────────────────────────────────────
RATE_LIMIT=30/minute
TEXT_MAX_CHARS=1200
IMAGE_MAX_BYTES=5000000
AUDIO_MAX_BYTES=8000000

# ─── Voice Configuration ────────────────────────────────────────────────────
# VOICE_MAX_TURNS=6
# VOICE_SESSION_TTL_SECONDS=3600
# EDGE_TTS_VOICE_VI=vi-VN-HoaiMyNeural
# EDGE_TTS_VOICE_EN=en-US-AriaNeural
