# ─── Environment ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── API Keys (Bắt buộc) ──────────────────────────────────────────────────────
# Lấy tại: https://aistudio.google.com/
GEMINI_API_KEY=
# Tùy chọn: key Gemini dự phòng. Backend sẽ thử GEMINI_API_KEY trước,
# sau đó GEMINI_API_KEY_2, rồi mới chuyển sang Groq nếu LLM_PROVIDER_ORDER=gemini,groq.
GEMINI_API_KEY_2=
# Tùy chọn nâng cao: có thể khai báo nhiều key bằng dấu phẩy.
# GEMINI_API_KEYS=gemini_key_3,gemini_key_4

# Lấy tại: https://console.groq.com/
GROQ_API_KEY=

# Lấy tại: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_tour_guide

# ─── LLM Configuration ──────────────────────────────────────────────────────
LLM_PROVIDER_ORDER=gemini,groq
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
# Model riêng cho GEMINI_API_KEY_2, nên để khác model chính để giảm lỗi 503 cùng lúc.
GEMINI_TEXT_MODEL_2=gemini-3.1-flash-lite
# Tùy chọn nâng cao: model cho các key trong GEMINI_API_KEYS, phân tách bằng dấu phẩy.
# GEMINI_TEXT_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_VISION_MODEL=gemini-2.5-flash
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3 
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=2048
LLM_MAX_TOKENS_FOLLOWUP=800
LLM_MAX_TOKENS_IMAGE=650
VISION_CONFIDENCE_THRESHOLD=0.6

# ─── Request Limits / Cost Guard ────────────────────────────────────────────
RATE_LIMIT=30/minute
TEXT_MAX_CHARS=1200
IMAGE_MAX_BYTES=5000000
AUDIO_MAX_BYTES=8000000

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ─── Voice Configuration (Tùy chọn) ──────────────────────────────────────────
# EDGE_TTS_VOICE_VI=vi-VN-HoaiMyNeural
# EDGE_TTS_VOICE_EN=en-US-AriaNeural


SUPERTONIC_API_URL=http://tts_engine:7788/v1/audio/speech
SUPERTONIC_VOICE_VI=F1
SUPERTONIC_VOICE_EN=M1

