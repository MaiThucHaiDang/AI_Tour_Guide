# ─── Environment ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── API Keys (Bắt buộc) ──────────────────────────────────────────────────────
# Lấy tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Lấy tại: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Lấy tại: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_tour_guide

# ─── LLM Configuration ──────────────────────────────────────────────────────
LLM_PROVIDER_ORDER=gemini,groq
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3 
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=5000
VISION_CONFIDENCE_THRESHOLD=0.6

# ─── Request Limits / Cost Guard ────────────────────────────────────────────
RATE_LIMIT=30/minute
TEXT_MAX_CHARS=1200
IMAGE_MAX_BYTES=5000000
AUDIO_MAX_BYTES=8000000

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ─── Voice Configuration (Tùy chọn) ──────────────────────────────────────────
# EDGE_TTS_VOICE_VI=vi-VN-HoaiMyNeural
# EDGE_TTS_VOICE_EN=en-US-AriaNeural
# EDGE_TTS_RATE=+0%
