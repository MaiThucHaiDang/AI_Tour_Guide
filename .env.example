# Application
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Database and cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_tour_guide
# Leave empty to use the in-process memory cache.
REDIS_URL=
CACHE_TTL_SECONDS=3600

# Google Gemini credentials
# Create keys at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
# Optional additional comma-separated keys:
# GEMINI_API_KEYS=gemini_key_5,gemini_key_6

# Groq credentials
# Create keys at https://console.groq.com/keys
GROQ_API_KEY=
# Optional additional comma-separated keys:
# GROQ_API_KEYS=groq_key_2,groq_key_3

# Models and provider order
LLM_PROVIDER_ORDER=gemini,groq
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_TEXT_MODEL_2=gemini-3.1-flash-lite
# GEMINI_TEXT_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3

# AI behavior
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=2048
LLM_MAX_TOKENS_FOLLOWUP=800
LLM_MAX_TOKENS_IMAGE=650
VISION_CONFIDENCE_THRESHOLD=0.6
VISION_TIMEOUT_SECONDS=40
STT_DOMAIN_HINTS=

# Request limits
RATE_LIMIT=30/minute
TEXT_MAX_CHARS=5000
IMAGE_MAX_BYTES=5000000
AUDIO_MAX_BYTES=8000000
BLOG_COVER_MAX_BYTES=5000000

# Browser clients
CORS_ORIGINS=["https://localhost:5173", "http://localhost:5173"]

# Optional legacy server-side speech synthesis
EDGE_TTS_VOICE_VI=vi-VN-HoaiMyNeural
EDGE_TTS_VOICE_EN=en-US-AriaNeural

# Optional VNPay Sandbox integration
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=https://localhost:5173/?view=paymentResult
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

